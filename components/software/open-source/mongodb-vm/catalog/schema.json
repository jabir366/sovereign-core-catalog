{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "MongoDB EA VM Instance Parameters",
  "description": "Keys below (other than instanceName, clusterTarget, namespace) are passed verbatim to the mongodb-vm Helm chart as values, so they mirror chart/values.yaml.",
  "properties": {
    "instanceName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]*$",
      "minLength": 1
    },
    "clusterTarget": {
      "type": "string"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]*$",
      "minLength": 1
    },
    "instance": {
      "type": "object",
      "description": "Resource name prefix for VMs, DataVolumes and Services (defaults to the chart name)",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9\\-]*$",
          "maxLength": 40
        }
      }
    },
    "diskImage": {
      "type": "object",
      "properties": {
        "sourceContainerDisk": {
          "type": "string",
          "minLength": 1,
          "description": "ContainerDisk image reference, e.g. <registry>/mongo-ea-bootc/mongodb-ea-bootc-containerdisk:8.3.2.17-s390x"
        },
        "pullSecret": {
          "type": "string",
          "description": "Secret in the instance namespace with keys accessKeyId/secretKey for the registry"
        },
        "certConfigMap": {
          "type": "string",
          "description": "ConfigMap in the instance namespace with key ca.crt for the registry CA"
        },
        "storageClassName": {
          "type": "string"
        },
        "diskSizeGi": {
          "type": "integer",
          "minimum": 20,
          "maximum": 500
        }
      },
      "required": ["sourceContainerDisk"]
    },
    "vm": {
      "type": "object",
      "properties": {
        "cpuCores": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "memoryGi": {
          "type": "integer",
          "minimum": 2,
          "maximum": 64
        }
      }
    },
    "mongodb": {
      "type": "object",
      "properties": {
        "databaseName": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$",
          "minLength": 1
        },
        "databaseUser": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$",
          "minLength": 1
        }
      },
      "required": ["databaseName", "databaseUser"]
    },
    "ha": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 3,
          "maximum": 7
        },
        "replicaSetName": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
        }
      },
      "required": ["enabled"]
    },
    "vip": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "lb_type": {
          "type": "string",
          "enum": ["local", "external"]
        },
        "nodePort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32767
        },
        "metallbAddressPool": {
          "type": "string"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "compliance": {
      "type": "object",
      "properties": {
        "enableEncryption": {
          "type": "boolean"
        },
        "auditLog": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "logging": {
      "type": "object",
      "properties": {
        "rsyslog": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "forwarding": {
              "type": "object",
              "description": "Chart keys: enabled (bool), host, port (1-65535), protocol (tcp|udp), format (rfc3164|rfc5424|json)"
            },
            "fileMonitoring": {
              "type": "object",
              "description": "Chart keys: mongodLog.enabled (bool), auditLog.enabled (bool)"
            },
            "rateLimit": {
              "type": "object",
              "description": "Chart keys: intervalSeconds (>=0), burstCount (>=1)"
            },
            "customConf": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "required": [
    "instanceName",
    "clusterTarget",
    "namespace",
    "diskImage",
    "mongodb",
    "ha"
  ]
}
