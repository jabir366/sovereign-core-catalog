{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "MongoDB EA VM Instance Parameters",
  "properties": {
    "instanceName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]*$",
      "minLength": 1
    },
    "clusterTarget": {
      "type": "string"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]*$",
      "minLength": 1
    },
    "container_disk_image": {
      "type": "string",
      "minLength": 1
    },
    "storage_class_name": {
      "type": "string"
    },
    "disk_size_gi": {
      "type": "integer",
      "minimum": 20,
      "maximum": 500
    },
    "database_name": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$",
      "minLength": 1
    },
    "database_user": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$",
      "minLength": 1
    },
    "vm_cpu_cores": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "vm_memory_gi": {
      "type": "integer",
      "minimum": 2,
      "maximum": 64
    },
    "ha_enabled": {
      "type": "boolean"
    },
    "ha_replica_count": {
      "type": "integer",
      "minimum": 3,
      "maximum": 7
    },
    "ha_replica_set_name": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
    },
    "vip_enabled": {
      "type": "boolean"
    },
    "vip_lb_type": {
      "type": "string"
    },
    "vip_node_port": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32767
    },
    "vip_metallb_address_pool": {
      "type": "string"
    },
    "network_policy_enabled": {
      "type": "boolean"
    },
    "service_account_enabled": {
      "type": "boolean"
    },
    "compliance_enable_encryption": {
      "type": "boolean"
    },
    "compliance_audit_log_enabled": {
      "type": "boolean"
    },
    "rsyslog_enabled": {
      "type": "boolean"
    },
    "rsyslog_forwarding_enabled": {
      "type": "boolean"
    },
    "rsyslog_forwarding_host": {
      "type": "string"
    },
    "rsyslog_forwarding_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "rsyslog_forwarding_protocol": {
      "type": "string"
    },
    "rsyslog_forwarding_format": {
      "type": "string"
    },
    "rsyslog_monitor_mongod_log": {
      "type": "boolean"
    },
    "rsyslog_monitor_audit_log": {
      "type": "boolean"
    },
    "rsyslog_ratelimit_interval": {
      "type": "integer",
      "minimum": 0
    },
    "rsyslog_ratelimit_burst": {
      "type": "integer",
      "minimum": 1
    },
    "rsyslog_custom_conf": {
      "type": "string"
    }
  },
  "required": [
    "instanceName",
    "clusterTarget",
    "namespace",
    "container_disk_image",
    "database_name",
    "database_user",
    "ha_enabled"
  ]
}
