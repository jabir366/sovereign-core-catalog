{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "instanceName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]*$"
    },
    "clusterTarget": {
      "type": "string"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]*$"
    },
    "instance": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9\\-]*$"
        }
      }
    },
    "diskImage": {
      "type": "object",
      "properties": {
        "sourceContainerDisk": {
          "type": "string",
          "minLength": 1
        },
        "pullSecret": {
          "type": "string"
        },
        "certConfigMap": {
          "type": "string"
        },
        "storageClassName": {
          "type": "string"
        },
        "diskSizeGi": {
          "type": "integer",
          "minimum": 20,
          "maximum": 500
        }
      },
      "required": [
        "sourceContainerDisk"
      ]
    },
    "vm": {
      "type": "object",
      "properties": {
        "cpuCores": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "memoryGi": {
          "type": "integer",
          "minimum": 2,
          "maximum": 64
        }
      }
    },
    "mongodb": {
      "type": "object",
      "properties": {
        "databaseName": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
        },
        "databaseUser": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
        }
      },
      "required": [
        "databaseName",
        "databaseUser"
      ]
    },
    "ha": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 3,
          "maximum": 7
        },
        "replicaSetName": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "vip": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "lb_type": {
          "type": "string",
          "enum": [
            "local",
            "external"
          ]
        },
        "nodePort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32767
        },
        "metallbAddressPool": {
          "type": "string"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  },
  "required": [
    "instanceName",
    "clusterTarget",
    "namespace",
    "diskImage",
    "mongodb",
    "ha"
  ]
}
