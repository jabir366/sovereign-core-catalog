{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "clusterTarget":                   {"type": "string",  "pattern": "^[a-zA-Z][a-zA-Z0-9-]*$"},
    "namespace":                       {"type": "string",  "default": "mongodb-vm"},
    "instanceName":                    {"type": "string",  "pattern": "^[a-z0-9][a-z0-9-]*$"},

    "diskImage.sourceContainerDisk":   {"type": "string"},
    "diskImage.pullSecret":            {"type": "string",  "default": ""},
    "diskImage.certConfigMap":         {"type": "string",  "default": ""},
    "diskImage.storageClassName":      {"type": "string",  "default": "ocs-storagecluster-ceph-rbd-virtualization"},
    "diskImage.diskSizeGi":            {"type": "integer", "default": 25},

    "vm.cpuCores":                     {"type": "integer", "default": 2},
    "vm.memoryGi":                     {"type": "integer", "default": 4},

    "mongodb.databaseName":            {"type": "string",  "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"},
    "mongodb.databaseUser":            {"type": "string",  "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"},

    "ha.enabled":                      {"type": "boolean", "default": false},
    "ha.replicaCount":                 {"type": "integer", "default": 3},
    "ha.replicaSetName":               {"type": "string",  "default": "rs0"},

    "vip.enabled":                     {"type": "boolean", "default": false},
    "vip.lb_type":                     {"type": "string",  "default": "local"},
    "vip.nodePort":                    {"type": "integer", "default": 0},
    "vip.metallbAddressPool":          {"type": "string",  "default": ""},

    "networkPolicy.enabled":           {"type": "boolean", "default": true},
    "serviceAccount.enabled":          {"type": "boolean", "default": true},

    "compliance.enableEncryption":     {"type": "boolean", "default": false},
    "compliance.auditLog.enabled":     {"type": "boolean", "default": false},
    "compliance.auditLog.path":        {"type": "string",  "default": "/var/log/mongodb/audit.json"},

    "logging.rsyslog.enabled":         {"type": "boolean", "default": false},
    "logging.rsyslog.forwarding.host": {"type": "string",  "default": ""},
    "logging.rsyslog.forwarding.port": {"type": "integer", "default": 514}
  },
  "required": [
    "clusterTarget",
    "namespace",
    "instanceName",
    "diskImage.sourceContainerDisk",
    "mongodb.databaseName",
    "mongodb.databaseUser",
    "ha.enabled"
  ]
}
